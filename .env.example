# Copy to .env and adjust as needed.
# Users log in through the web UI — no credentials are stored here.

VIVAGYM_LOCALE=es
PORT=4567
PUBLIC_URL=http://localhost:4567

# Optional
# COOKIE_MAX_AGE_DAYS=7
# LOGIN_RATE_PER_MIN=10
# TRUST_PROXY=1   # set behind a reverse proxy to use X-Forwarded-For for rate limiting
