# Copy to .env and fill in your VivaGym credentials
VIVAGYM_EMAIL=your@email.com
VIVAGYM_PASSWORD=your-password
VIVAGYM_LOCALE=es

# Public base URL used by the live QR page and the Wallet pass
# Set to your deployed HTTPS host, e.g. https://qr.example.com
PUBLIC_URL=http://localhost:4567
PORT=4567
